# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Format MySQL: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# XAMPP standar (user root, tanpa password):
DATABASE_URL="mysql://root:@localhost:3306/gilakomputer_db"

